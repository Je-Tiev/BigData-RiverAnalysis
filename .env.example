# ========================================================
# Big Data River Quality Platform - Environment Settings
# ========================================================

# --- KAFKA CONFIGURATION ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_BOOTSTRAP_INTERNAL=kafka-broker:19092
KAFKA_TOPIC_RAW=river.sensors.raw
KAFKA_TOPIC_DLQ=river.sensors.dlq
KAFKA_TOPIC_ALERTS=river.alerts.critical
KAFKA_CONSUMER_GROUP=river_quality_stream_group

# --- MINIO / S3 LAKEHOUSE ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=water-quality-lakehouse
MINIO_SECURE=false

# --- INFLUXDB 2.x METRICS ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_ORG=water-quality
INFLUXDB_BUCKET=river-data

# --- SPARK CONFIGURATION ---
SPARK_MASTER=spark://spark-master:7077
SPARK_APP_NAME=RiverQuality_Streaming_Engine
SPARK_CHECKPOINT_BASE=/opt/spark-data/checkpoints
SPARK_TRIGGER_SECONDS=10
SPARK_WATERMARK_DURATION=10 minutes

# --- SIMULATOR CONFIGURATION ---
SIMULATOR_DELAY_SECONDS=1.0
SIMULATOR_ANOMALY_PROB=0.08
SIMULATOR_STATION_COUNT=10
