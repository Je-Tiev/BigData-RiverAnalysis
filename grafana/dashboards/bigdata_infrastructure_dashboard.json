      "title": "Hạ Tầng Kafka & Spark Streaming Observability",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "Kafka Consumer Group Lag (Messages)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{topic=\"river.sensors.raw\"}",
          "legendFormat": "Partition {{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "Kafka Ingestion Throughput (Messages / Sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_messagesin_total{topic=\"river.sensors.raw\"}[1m])",
          "legendFormat": "Ingestion Rate (msg/s)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Spark Cluster & JVM Memory Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "Spark Streaming Batch Duration (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "metrics_spark_streaming_lastCompletedBatch_processingDelay_value",
          "legendFormat": "Batch Duration (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "Spark Executor JVM Heap Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_memory_bytes_used{area=\"heap\"}",
          "legendFormat": "{{instance}} Heap Used",
          "refId": "A"
        }
      ]
    }
